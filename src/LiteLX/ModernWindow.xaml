<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LiteLX" Width="640" Height="520" MinWidth="600" MinHeight="480" WindowStartupLocation="CenterScreen" Background="#F5F6FA" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#202432">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#5264F5"/>
  <Style TargetType="Button"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="17,10"/><Setter Property="Background" Value="#EDF0FF"/><Setter Property="Foreground" Value="#4659DF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Nav" TargetType="RadioButton"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#7B8091"/><Setter Property="Padding" Value="12,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Surface" CornerRadius="11" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="White"/><Setter Property="Foreground" Value="#485CED"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="CornerRadius" Value="16"/><Setter Property="Background" Value="White"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="2,1"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EDF0FF"/><Setter Property="Foreground" Value="#4659DF"/></Trigger>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E5E9FF"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="MinHeight" Value="32"/><Setter Property="Background" Value="#F7F8FC"/><Setter Property="BorderBrush" Value="#E1E5F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,5,32,5"/><Setter Property="MaxDropDownHeight" Value="280"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid SnapsToDevicePixels="True">
     <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border x:Name="Surface" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="8">
        <Path Data="M 0,0 L 4,4 L 8,0" Stroke="#7B8299" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
       </Border>
       <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EDF0FF"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#5264F5"/></Trigger>
       </ControlTemplate.Triggers>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
      <Border Background="White" BorderBrush="#E1E5F0" BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
       <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#5264F5"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#E5E7EF"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Title" TargetType="TextBlock"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#858A9B"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="23"/></Style>
 </Window.Resources>
 <Grid Margin="18,12,18,12"><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#5264F5" CornerRadius="12" Width="42" Height="42"><TextBlock Text="L" FontSize="25" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="LiteLX" FontSize="23" FontWeight="Bold"/><TextBlock Text="系统轻量工具" Foreground="#989CAC" FontSize="11"/></StackPanel></StackPanel><TextBlock x:Name="MachineModel" Grid.Column="1" Text="本地运行" Margin="24,0,0,0" TextAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" Foreground="#969BAB" FontSize="12"/></Grid>
  <Border Grid.Row="1" Background="#EAECF3" CornerRadius="14" Padding="4" Margin="0,2,0,12"><UniformGrid Columns="3"><RadioButton x:Name="NavLogo" Style="{StaticResource Nav}" Content="开机画面" IsChecked="True"/><RadioButton x:Name="NavMenu" Style="{StaticResource Nav}" Content="右键菜单"/><RadioButton x:Name="NavFan" Style="{StaticResource Nav}" Content="风扇除尘"/></UniformGrid></Border>
  <Grid Grid.Row="2">
   <Border x:Name="LogoPage" Background="White" CornerRadius="14" Padding="20,18,20,0"><Grid><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="52"/></Grid.RowDefinitions><TextBlock Text="开机画面定制" FontSize="18" FontWeight="SemiBold"/>
    <Grid Grid.Row="1" Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="22"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><Border Background="Black" MaxHeight="180" VerticalAlignment="Stretch"><Image x:Name="LogoPreview" Stretch="Uniform"/></Border><StackPanel Grid.Column="2"><TextBlock Text="最大支持分辨率" FontSize="14"/><TextBlock Text="2560 × 1600" Foreground="#858A9B" Margin="0,5,0,10"/><TextBlock Text="支持图片格式" FontSize="14"/><TextBlock Text="*.bmp" Foreground="#858A9B" Margin="0,5,0,10"/><Button x:Name="UploadLogo" Content="自定义添加" HorizontalAlignment="Left" Padding="16,8"/></StackPanel></Grid>
    <TextBlock x:Name="LogoNotice" Grid.Row="2" Text="保存会替换图片并写入固件，恢复默认会清理自定义图片。重启后生效。&#x0a;启动时授权一次，点击保存或恢复即可执行。" FontSize="11" Foreground="#858A9B" TextWrapping="Wrap" LineHeight="16" Margin="0,8,0,0"/>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="RestoreLogo" Content="恢复默认画面" Background="Transparent" Padding="0,8" HorizontalAlignment="Left"/><Button x:Name="CancelLogo" Grid.Column="1" Content="取消" Padding="24,8" Margin="0,0,10,0"/><Button x:Name="SaveLogo" Grid.Column="2" Content="保存" Background="#5264F5" Foreground="White" Padding="24,8"/></Grid>
   </Grid></Border>
   <Grid x:Name="MenuPage" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="White" CornerRadius="14" Padding="16,10" Margin="0,0,0,8">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="MenuCount" Text="右键菜单" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button x:Name="RefreshMenus" Grid.Column="1" Content="刷新" Padding="14,5"/>
      <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="MenuScope" SelectedIndex="0" AutomationProperties.Name="菜单范围"><ComboBoxItem Content="文件右键"/><ComboBoxItem Content="桌面右键"/><ComboBoxItem Content="全部注册项"/></ComboBox>
       <TextBox x:Name="MenuSearch" Grid.Column="2" ToolTip="搜索名称或注册路径" AutomationProperties.Name="搜索名称或注册路径" Padding="10,5" MinHeight="32">
        <TextBox.Template><ControlTemplate TargetType="TextBox">
         <Border x:Name="Surface" Background="#F7F8FC" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
          <Grid>
           <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
           <TextBlock x:Name="Placeholder" Text="搜索名称或注册路径" Foreground="#969BAB" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
          </Grid>
         </Border>
         <ControlTemplate.Triggers><Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#5264F5"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></TextBox.Template>
       </TextBox>
      </Grid>
      <TextBlock x:Name="MenuNotice" Grid.Row="2" Grid.ColumnSpan="2" Text="点击开关直接启用或禁用，同一扩展的其他入口同步变更。" FontSize="11" Foreground="#858A9B" TextWrapping="Wrap" LineHeight="15" Margin="0,6,0,0"/>
     </Grid>
    </Border>
    <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="10,4">
     <ListBox x:Name="MenuList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
       <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Surface" Background="Transparent" CornerRadius="6"><ContentPresenter/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5F7FF"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EDF0FF"/></Trigger></ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
      </Style></ListBox.ItemContainerStyle>
     </ListBox>
    </Border>
   </Grid>
   <ScrollViewer x:Name="FanPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="风扇除尘" Style="{StaticResource Title}"/><TextBlock x:Name="FanNotice" Text="按所选时长全速运行，自动停止并回读状态，可提前停止。" Style="{StaticResource Hint}" FontSize="11" LineHeight="16"/><Border Background="#F5F7FF" CornerRadius="12" Padding="20" Margin="0,22,0,20"><DockPanel><TextBlock Text="运行时长" VerticalAlignment="Center" FontWeight="SemiBold"/><ComboBox x:Name="FanDuration" SelectedIndex="0" Width="110" HorizontalAlignment="Right"><ComboBoxItem Content="5 秒" Tag="5"/><ComboBoxItem Content="10 秒" Tag="10"/><ComboBoxItem Content="18 秒" Tag="18"/></ComboBox></DockPanel></Border><WrapPanel><Button x:Name="RunFan" Content="开始除尘" Background="#5264F5" Foreground="White" Margin="0,0,12,0"/><Button x:Name="StopFan" Content="提前停止" IsEnabled="False" Margin="0,0,12,0"/><Button x:Name="ReadFan" Content="读取状态"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer>
  </Grid>
  <DockPanel Grid.Row="3" VerticalAlignment="Bottom"><TextBlock x:Name="Status" Text="就绪" Foreground="#8E93A3" FontSize="11" TextTrimming="CharacterEllipsis"/><Button x:Name="Details" Content="详情" Padding="8,2" Background="Transparent" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
 </Grid>
</Window>
